{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kugelblitz",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "STORE", "class_name": "Store" },
      { "name": "TABLES", "class_name": "SFTable" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Store"] },
    { "tag": "v3", "new_sqlite_classes": ["SFTable"] }
  ]
}
